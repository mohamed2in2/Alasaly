############################################################
# .env.example - final cleaned example
# Copy this file to `.env` and fill the values. NEVER commit `.env`.
############################################################

# App settings
APP_ENV=development            # development or production
LOG_LEVEL=info                # debug, info, warn, error

############################################################
# Supabase (required)
############################################################
# Project URL (from Project → Settings → API)
SUPABASE_URL=

# Public anon key (safe for client only if RLS + policies are configured)
SUPABASE_ANON_KEY=

# Server-only service role key (keep this secret; do NOT expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

############################################################
# Database (choose one: DATABASE_URL OR individual DB_* vars)
############################################################
# Option A: full Postgres connection string (recommended)
# Example: postgresql://postgres:YOUR_DB_PASS@db.pppaqujnvgksstrnafhl.supabase.co:5432/postgres
DATABASE_URL=

# Option B: individual connection pieces (used if DATABASE_URL is empty)
DB_HOST=db.pppaqujnvgksstrnafhl.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=

############################################################
# Storage / Signed URLs
############################################################
# Name of the private bucket in Supabase Storage
STORAGE_BUCKET=

# Signed URL expiry (seconds) for playback
SIGNED_URL_EXPIRE_SECONDS=3600

############################################################
# BunnyCDN (optional) - keep these secret if used
############################################################
BUNNY_LIBRARY_ID=
BUNNY_SECURITY_KEY=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_PULL_ZONE=
BUNNY_TOKEN_EXPIRY=7200

############################################################
# Application options
############################################################
ADMIN_PASSWORD=

# Demo/test mode: useful for local dev, set to 0 in production
DEMO_MODE_ENABLED=0
DEMO_ACCESS_CODE=DEMO1-PLAY9
DEMO_VIDEO_URL=https://www.youtube.com/embed/e1yDqlXin8g

############################################################
# Watch session hardening
############################################################
# Lifetime of the session-bound watch URL after verification (seconds)
WATCH_ACCESS_TTL_SECONDS=300

# Consume watch token after first successful open (1 = yes)
WATCH_ONE_TIME_USE=1

# Add on-screen watermark overlay to discourage recording/share abuse
WATCH_WATERMARK_ENABLED=1

############################################################
# Misc
############################################################
# Comma-separated banned IPs (exact IP or CIDR). Example:
# 203.0.113.10,198.51.100.0/24,2001:db8::/32
BANNED_IPS=

# End of file